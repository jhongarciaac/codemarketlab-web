---
---
<footer class="bg-slate-100 dark:bg-[#070A11] border-t border-slate-200 dark:border-slate-800/80 py-16 text-slate-600 dark:text-slate-400 text-sm transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Columna 1: Logo e Identidad -->
      <div class="space-y-4">
        <img src="/logo-codemarket.png" alt="CodeMarket" class="h-10 w-auto object-contain" />
        <p class="text-xs text-slate-500 leading-relaxed">
          Laboratorio de software y soluciones tecnológicas empresariales. Innovación y desarrollo cloud en Perú.
        </p>
      </div>

      <!-- Columna 2: Enlaces Rápidos -->
      <div>
        <h4 class="text-slate-900 dark:text-white font-bold text-sm mb-4">Plataforma</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Inicio</a></li>
          <li><a href="/factuapp" class="hover:text-blue-600 dark:hover:text-blue-400 transition font-semibold text-blue-600 dark:text-blue-400">FactuApp ERP SUNAT</a></li>
          <li><a href="https://demo.factuapp.pro" target="_blank" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Ingreso Demo</a></li>
          <li><a href="/#servicios" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Desarrollo a Medida</a></li>
        </ul>
      </div>

      <!-- Columna 3: Horarios de Atención (Con el Badge tal cual) -->
      <div>
        <h4 class="text-slate-900 dark:text-white font-bold text-sm mb-4">Horarios de Atención</h4>
        <div class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <p><strong class="text-slate-800 dark:text-slate-200">Ventas & Asesoría:</strong></p>
          <p>Lun - Vie: 8:30 AM - 7:00 PM</p>
          <p>Sábados: 9:00 AM - 1:00 PM</p>
          
          <div class="pt-3">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Soporte Online 24/7 vía WhatsApp
            </div>
          </div>
        </div>
      </div>

      <!-- Columna 4: Redes Sociales -->
      <div>
        <h4 class="text-slate-900 dark:text-white font-bold text-sm mb-4">Redes Sociales</h4>
        <p class="text-xs text-slate-500 mb-4 leading-relaxed">
          Síguenos para conocer actualizaciones, tutoriales y novedades de nuestros productos.
        </p>
        
        <!-- Íconos de Redes Sociales -->
        <div class="flex items-center gap-3">
          
          <!-- WhatsApp -->
          <a 
            href="https://wa.me/51920306004" 
            target="_blank" 
            aria-label="WhatsApp"
            class="w-9 h-9 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-emerald-500 hover:text-emerald-500 flex items-center justify-center transition shadow-sm"
          >

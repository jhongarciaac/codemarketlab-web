---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FactuApp | Sistema ERP y Facturación Electrónica SUNAT" description="Facturación electrónica ilimitada, POS veloz, control de inventarios y giros especializados para empresas en Perú.">
  
  <!-- SCHEMA SEO STRUCTURAL DATA -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "FactuApp",
      "operatingSystem": "Web, Windows, macOS, Android, iOS",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "PEN",
        "lowPrice": "40",
        "highPrice": "100",
        "pricePeriod": "MONTH"
      }
    }
  </script>

  <!-- BOTÓN FLOTANTE WHATSAPP -->
  <div class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
    <div class="hidden sm:block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 text-xs py-2 px-3.5 rounded-lg shadow-xl font-medium">
      👋 ¿Dudas con tu rubro? <strong>Escríbenos en vivo</strong>
    </div>
    <a 
      href="https://wa.me/51920306004?text=Hola,%20tengo%20consultas%20sobre%20FactuApp" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class="h-14 w-14 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-2xl shadow-emerald-500/40 transition hover:scale-105"
    >
      <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.24-.038.375.289.145.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
      </svg>
    </a>
  </div>

  <!-- HERO FACTUAPP -->
  <section class="relative pt-10 pb-16 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Logo FactuApp -->
      <div class="flex justify-center mb-6">
        <img src="/logo-factuapp.png" alt="FactuApp" class="h-20 sm:h-28 w-auto object-contain drop-shadow-md" />
      </div>

      <!-- Badges Superiores Rectangulares -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mb-8">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-bold">
          <span class="w-1.5 h-1.5 rounded-sm bg-emerald-500 animate-pulse"></span>
          Conexión Directa SUNAT & OSE Homologado
        </div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-500/10 border border-blue-500/30 text-blue-700 dark:text-blue-400 text-[11px] font-bold">
          ⚡ Soporte Crítico 24/7 por WhatsApp
        </div>
      </div>
      
      <!-- Título de Alto Impacto -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-900 dark:text-white max-w-4xl mx-auto leading-tight">
        Facturación electrónica y ERP diseñado para <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-sky-500 to-emerald-500">vender sin interrupciones</span>
      </h1>
      
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed font-medium">
        El sistema en la nube más completo para Perú: comprobantes ilimitados, kardex valorizado, punto de venta y módulos especializados para tu rubro.
      </p>

      <!-- Botones de Acción -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="https://demo.factuapp.pro/" 
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition shadow-xl shadow-blue-600/30 flex items-center justify-center gap-2"
        >
          <span>Ingresar al Demo en Vivo</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a 
          href="https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20asesoria%20comercial%20para%20activar%20mi%20cuenta" 
          target="_blank"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white font-bold text-sm transition shadow-sm"
        >
          Hablar con Asesor
        </a>
      </div>

      <!-- Credenciales del Demo -->
      <div class="mt-6 inline-block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg px-4 py-2 text-xs text-slate-700 dark:text-slate-300 shadow-sm">
        🔑 Acceso Demo: <span class="text-blue-600 dark:text-blue-400 font-mono font-bold">demo@gmail.com</span> / Clave: <span class="text-blue-600 dark:text-blue-400 font-mono font-bold">123456</span>
      </div>

      <!-- MOCKUP PRINCIPAL -->
      <div class="mt-14 max-w-5xl mx-auto relative">
        <div class="absolute -top-3 right-4 z-20 hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded bg-slate-900/90 text-white border border-slate-700 text-[11px] shadow-lg">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          SUNAT Servidor Oficial: Operativo 99.9%
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0E131F] shadow-2xl p-2 sm:p-3">
          <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
            <img 
              src="/dashboard-real.png" 
              alt="Panel Principal FactuApp ERP" 
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto object-cover object-top block"
              onerror="this.onerror=null; this.src='/dashboard.png';"
            />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- FEATURES DESCRIPTIVAS COMPLETAS DEL ERP -->
  <section class="py-24 space-y-24">
    
    <!-- 1. Emisión y WhatsApp -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Emisión sin fricción</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mt-2 leading-tight">
            Comprobantes listos en 5 segundos y directos al WhatsApp de tu cliente
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
            Emite Facturas, Boletas y Notas de Crédito conectadas automáticamente con SUNAT. Envía el PDF y XML por WhatsApp o correo en un clic, sin necesidad de descargar archivos.
          </p>
          <ul class="mt-6 space-y-2.5 text-sm text-slate-700 dark:text-slate-300 font-medium">
            <li class="flex items-center gap-2">✓ Búsqueda automática de RUC y DNI sincronizada con RENIEC.</li>
            <li class="flex items-center gap-2">✓ Formatos de impresión A4, 80mm y 58mm para tiqueteras térmicas.</li>
            <li class="flex items-center gap-2">✓ Almacenamiento seguro de XML y CDR oficial descargables.</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xl">
          <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800">
            <img 
              src="/feature-ventas.png" 
              alt="Módulo de Ventas" 
              loading="lazy"
              class="w-full h-auto object-cover block"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80';"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Punto de Venta (POS) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xl">
          <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800">
            <img 
              src="/feature-pos.png" 
              alt="Punto de Venta POS" 
              loading="lazy"
              class="w-full h-auto object-cover block"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1556742049-0a67c5574f73?auto=format&fit=crop&w=800&q=80';"
            />
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Punto de Venta Ultra Veloz</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mt-2 leading-tight">
            Diseñado para atender colas rápidas sin bloquear tu operación
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
            El módulo POS funciona con pantalla táctil o lector de código de barras. Soporta pagos mixtos (Efectivo, Yape, Plin, Tarjeta), apertura/cierre de caja chica y reporte de turnos.
          </p>
          <ul class="mt-6 space-y-2.5 text-sm text-slate-700 dark:text-slate-300 font-medium">
            <li class="flex items-center gap-2">✓ Compatible con cualquier impresora térmica USB, Bluetooth o Red.</li>
            <li class="flex items-center gap-2">✓ Arqueo de caja y control de sobrantes / faltantes al instante.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 3. Inventario, Almacenes y Kardex -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Control Logístico</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mt-2 leading-tight">
            Kardex valorizado, multialmacén y control de compras
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
            Nunca más te quedes sin stock. Monitorea entradas, salidas, traslados entre sucursales y registra tus facturas de compra para conocer tus márgenes reales de ganancia.
          </p>
          <ul class="mt-6 space-y-2.5 text-sm text-slate-700 dark:text-slate-300 font-medium">
            <li class="flex items-center gap-2">✓ Alertas preventivas automáticas de productos por agotarse.</li>
            <li class="flex items-center gap-2">✓ Importación y exportación masiva en Excel en 2 minutos.</li>
            <li class="flex items-center gap-2">✓ Valorización de inventario según costo promedio.</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xl">
          <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800">
            <img 
              src="/feature-inventario.png" 
              alt="Inventario y Kardex" 
              loading="lazy"
              class="w-full h-auto object-cover block"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80';"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Guías de Remisión Electrónicas (GRE) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xl">
          <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800">
            <img 
              src="/feature-gre.png" 
              alt="Guías de Remisión Electrónicas GRE" 
              loading="lazy"
              class="w-full h-auto object-cover block"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=800&q=80';"
            />
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Normativa SUNAT Obligatoria</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mt-2 leading-tight">
            Guías de Remisión Electrónicas (GRE) Remitente y Transportista
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
            Traslada mercadería sin contingencias ni multas. Genera tus GRE directamente desde el sistema, con código QR oficial y validación en tiempo real ante la SUNAT.
          </p>
          <ul class="mt-6 space-y-2.5 text-sm text-slate-700 dark:text-slate-300 font-medium">
            <li class="flex items-center gap-2">✓ Generación automática a partir de una factura o boleta previa.</li>
            <li class="flex items-center gap-2">✓ Registro de conductores, vehículos, placas y puntos de llegada/partida.</li>
          </ul>
        </div>
      </div>
    </div>

  </section>

  <!-- GIROS DE NEGOCIO -->
  <section class="py-20 bg-slate-100/60 dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs uppercase font-bold tracking-widest text-blue-600 dark:text-blue-400">Especialización</h2>
        <p class="mt-2 text-3xl font-black text-slate-900 dark:text-white">Adaptado exactamente a tu rubro de trabajo</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm hover:border-blue-500 transition">
          <div class="text-4xl mb-4">🛍️</div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Comercio & POS</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Punto de venta táctil, lector de códigos de barras, control de cajas y ticket rápido.</p>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm hover:border-emerald-500 transition">
          <div class="text-4xl mb-4">🍽️</div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Restaurantes</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Mesas interactivas, comandas por área a cocina, división de cuentas y delivery.</p>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm hover:border-amber-500 transition">
          <div class="text-4xl mb-4">💊</div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Farmacias / Boticas</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Control de lotes, fechas de vencimiento obligatorias y principio activo.</p>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm hover:border-blue-500 transition">
          <div class="text-4xl mb-4">🏨</div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Hoteles</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Control de habitaciones (check-in / check-out), tarifas por noche/hora y consumos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TABLA DE PRECIOS CON TOGGLE MENSUAL/ANUAL -->
  <section class="py-24" id="precios">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-xs uppercase font-bold tracking-widest text-emerald-600 dark:text-emerald-400">Planes y Precios</h2>
        <p class="mt-2 text-3xl font-black text-slate-900 dark:text-white">Sin sorpresas ni cobros por factura emitida</p>
      </div>

      <!-- SWITCH MENSUAL / ANUAL -->
      <div class="flex items-center justify-center gap-3 mb-14">
        <span class="text-sm font-bold text-slate-700 dark:text-slate-300" id="label-monthly">Mensual</span>
        <button 
          id="billing-toggle" 
          type="button" 
          aria-label="Alternar plan de pago"
          class="w-14 h-8 bg-slate-300 dark:bg-slate-700 rounded-full p-1 transition-colors duration-300 relative focus:outline-none"
        >
          <div id="toggle-circle" class="w-6 h-6 bg-white dark:bg-blue-500 rounded-full shadow-md transition-transform duration-300 transform translate-x-0"></div>
        </button>
        <span class="text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5" id="label-annual">
          Anual 
          <span class="bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded">
            Ahorra 2 meses + Activación S/ 0
          </span>
        </span>
      </div>

      <!-- 3 TARJETAS DE PLANES PRINCIPALES -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        
        <!-- PLAN BASICO -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 flex flex-col justify-between shadow-sm">
          <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Básico</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Para formalizarte y emitir sin límites</p>
            <div class="mt-6">
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-extrabold text-slate-900 dark:text-white font-mono" id="price-basic">S/ 40</span>
                <span class="text-slate-500 dark:text-slate-400 text-sm" id="period-basic">/mes</span>
              </div>
              <p class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold mt-1" id="subtext-basic">
                o S/ 400 al año (Ahorra 2 meses)
              </p>
            </div>
            <ul class="mt-8 space-y-3 text-sm text-slate-600 dark:text-slate-300">
              <li class="flex items-center gap-2">✓ Facturas y Boletas ilimitadas</li>
              <li class="flex items-center gap-2">✓ Conexión directa SUNAT</li>
              <li class="flex items-center gap-2">✓ Envío por WhatsApp y Correo</li>
              <li class="flex items-center gap-2">✓ Consulta DNI / RUC automática</li>
              <li class="flex items-center gap-2">✓ 1 Usuario / 1 Sucursal</li>
              <li class="flex items-center gap-2">✓ Soporte estándar</li>
            </ul>
          </div>
          <a 
            id="btn-basic"
            href="https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Básico%20Mensual%20de%20S/%2040" 
            target="_blank" 
            class="mt-8 block text-center py-3.5 px-4 rounded-xl border border-slate-300 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-500 font-bold text-sm transition text-slate-900 dark:text-white"
          >
            Elegir Básico
          </a>
        </div>

        <!-- PLAN COMERCIAL -->
        <div class="bg-white dark:bg-slate-900 border-2 border-blue-600 rounded-3xl p-8 flex flex-col justify-between relative shadow-xl">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-[10px] font-bold px-2.5 py-0.5 rounded uppercase tracking-wider">
            Más Popular
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Comercial</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Ideal para tiendas, ventas y stock</p>
            <div class="mt-6">
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-extrabold text-slate-900 dark:text-white font-mono" id="price-commercial">S/ 70</span>
                <span class="text-slate-500 dark:text-slate-400 text-sm" id="period-commercial">/mes</span>
              </div>
              <p class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold mt-1" id="subtext-commercial">
                o S/ 700 al año (Ahorra 2 meses)
              </p>
            </div>
            <ul class="mt-8 space-y-3 text-sm text-slate-600 dark:text-slate-300">
              <li class="flex items-center gap-2 font-bold text-blue-600 dark:text-blue-400">✓ Todo lo del Plan Básico</li>
              <li class="flex items-center gap-2 font-semibold">✓ 3 Usuarios y 3 Sucursales</li>
              <li class="flex items-center gap-2">✓ Punto de Venta (POS) rápido</li>
              <li class="flex items-center gap-2">✓ Control de Inventario y Kardex</li>
              <li class="flex items-center gap-2">✓ Módulo de Compras y Proveedores</li>
              <li class="flex items-center gap-2">✓ Reportes de utilidades y ventas</li>

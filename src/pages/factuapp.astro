  <!-- JAVASCRIPT NATIVO PARA EL SWITCH INTERACTIVO MENSUAL/ANUAL -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('billing-toggle');
      const circle = document.getElementById('toggle-circle');
      let isAnnual = false;

      const prices = {
        monthly: { basic: 'S/ 40', commercial: 'S/ 70', pro: 'S/ 100', period: '/mes' },
        annual: { basic: 'S/ 400', commercial: 'S/ 700', pro: 'S/ 1,000', period: '/año' }
      };

      const links = {
        monthly: {
          basic: 'https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Básico%20Mensual%20de%20S/%2040',
          commercial: 'https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Comercial%20Mensual%20de%20S/%2070',
          pro: 'https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Pro%20Mensual%20de%20S/%20100'
        },
        annual: {
          basic: 'https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Básico%20ANUAL%20(S/%20400)%20con%20Activación%20GRATIS',
          commercial: 'https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Comercial%20ANUAL%20(S/%20700)%20con%20Activación%20GRATIS',
          pro: 'https://wa.me/51920306004?text=Hola%20Jhon,%20deseo%20el%20Plan%20Pro%20ANUAL%20(S/%201000)%20con%20Activación%20GRATIS'
        }
      };

      if (toggle) {
        toggle.addEventListener('click', () => {
          isAnnual = !isAnnual;

          // Animate switch
          if (isAnnual) {
            circle.classList.remove('translate-x-0');
            circle.classList.add('translate-x-6');
            toggle.classList.add('bg-blue-600');
            toggle.classList.remove('bg-slate-300', 'dark:bg-slate-700');
          } else {
            circle.classList.remove('translate-x-6');
            circle.classList.add('translate-x-0');
            toggle.classList.remove('bg-blue-600');
            toggle.classList.add('bg-slate-300', 'dark:bg-slate-700');
          }

          // Update texts
          const p = isAnnual ? prices.annual : prices.monthly;
          const l = isAnnual ? links.annual : links.monthly;

          document.getElementById('price-basic').textContent = p.basic;
          document.getElementById('price-commercial').textContent = p.commercial;
          document.getElementById('price-pro').textContent = p.pro;

          document.getElementById('period-basic').textContent = p.period;
          document.getElementById('period-commercial').textContent = p.period;
          document.getElementById('period-pro').textContent = p.period;

          document.getElementById('subtext-basic').textContent = isAnnual ? 'Facturado anualmente (Activación S/ 0)' : 'o S/ 400 al año (Ahorra 2 meses)';
          document.getElementById('subtext-commercial').textContent = isAnnual ? 'Facturado anualmente (Activación S/ 0)' : 'o S/ 700 al año (Ahorra 2 meses)';
          document.getElementById('subtext-pro').textContent = isAnnual ? 'Facturado anualmente (Activación S/ 0)' : 'o S/ 1,000 al año (Ahorra 2 meses)';

          document.getElementById('btn-basic').href = l.basic;
          document.getElementById('btn-commercial').href = l.commercial;
          document.getElementById('btn-pro').href = l.pro;
        });
      }
    });
  </script>


---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="CodeMarket Lab | Fábrica de Software, Integraciones SUNAT & Cloud" 
  description="Desarrollo de software a medida, APIs para facturación electrónica SUNAT, ERPs escalables y arquitectura en la nube para empresas en Perú y Latinoamérica."
>

  <!-- SCHEMA ORGANIZACIÓN SEO -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CodeMarket Lab",
      "url": "https://codemarket.pe",
      "logo": "/logo-factuapp.png",
      "description": "Fábrica de software especializada en soluciones cloud, integraciones SUNAT y plataformas SaaS empresariales.",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+51920306004",
        "contactType": "sales",
        "areaServed": "PE"
      }
    }
  </script>

  <!-- BOTÓN FLOTANTE WHATSAPP -->
  <div class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
    <div class="hidden sm:block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 text-xs py-2 px-3.5 rounded-lg shadow-xl font-medium">
      💼 ¿Tienes un proyecto en mente? <strong>Conversemos en vivo</strong>
    </div>
    <a 
      href="https://wa.me/51920306004?text=Hola%20CodeMarket%20Lab,%20deseo%20cotizar%20un%20proyecto%20de%20software" 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Contactar a CodeMarket Lab por WhatsApp"
      class="h-14 w-14 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-2xl shadow-emerald-500/40 transition hover:scale-105"
    >
      <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.24-.038.375.289.145.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
      </svg>
    </a>
  </div>

  <!-- HERO CODEMARKET LAB -->
  <section class="relative pt-16 pb-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Etiquetas Superiores Compactas -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-500/10 border border-blue-500/30 text-blue-700 dark:text-blue-400 text-[11px] font-bold">
          ⚡ Ingeniería de Software & Arquitectura Cloud
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-bold">
          🇵🇪 Homologación Directa con SUNAT
        </span>
      </div>

      <!-- Título Principal -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-900 dark:text-white max-w-4xl mx-auto leading-tight">
        Construimos software robusto que <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-sky-500 to-emerald-500">acelera el crecimiento</span> de tu empresa
      </h1>
      
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
        En <strong>CodeMarket Lab</strong> transformamos procesos complejos en plataformas digitales ágiles: sistemas ERP modernos, microservicios en la nube y APIs de facturación electrónica de alta disponibilidad.
      </p>

      <!-- Botones Principales -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#servicios" 
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition shadow-xl shadow-blue-600/30 flex items-center justify-center gap-2"
        >
          <span>Explorar Servicios</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a 
          href="https://wa.me/51920306004?text=Hola%20CodeMarket%20Lab,%20deseo%20agendar%20una%20reunion%20tecnica" 
          target="_blank"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white font-bold text-sm transition shadow-sm"
        >
          Agendar Consulta Técnica
        </a>
      </div>

      <!-- BANNER PRODUCTO INSIGNIA: FACTUAPP -->
      <div class="mt-16 text-left max-w-5xl mx-auto">
        <div class="p-1 rounded-3xl bg-gradient-to-r from-blue-600 via-sky-500 to-emerald-500 shadow-2xl">
          <div class="bg-white dark:bg-slate-900 rounded-[22px] p-6 sm:p-10 flex flex-col lg:flex-row items-center justify-between gap-8">
            <div class="space-y-4 max-w-2xl">
              <div class="flex items-center gap-2">
                <span class="bg-blue-600 text-white text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded">
                  Producto Insignia
                </span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  ● Conexión Directa SUNAT / OSE
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white leading-tight">
                FactuApp ERP & Facturación Electrónica Ilimitada
              </h3>
              <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                Nuestra plataforma SaaS líder para la gestión integral de empresas: emisión ultrarrápida de comprobantes en menos de 5 segundos, control multialmacén, kardex valorizado, punto de venta (POS) y módulos para boticas, restaurantes y hoteles.
              </p>
              
              <div class="flex flex-wrap gap-2 text-[11px] font-semibold text-slate-600 dark:text-slate-300">
                <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">✓ Planes desde S/ 40/mes</span>
                <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">✓ Comprobantes Ilimitados</span>
                <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">✓ Envío por WhatsApp en un Clic</span>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto shrink-0">
              <a 
                href="/factuapp" 
                class="px-7 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm text-center transition shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2"
              >
                <span>Ver Planes y Detalles</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a 
                href="https://demo.factuapp.pro/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-7 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold text-sm text-center transition border border-slate-200 dark:border-slate-700"
              >
                Probar Demo en Vivo
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- MÉTRICAS DE IMPACTO -->
  <section class="py-12 bg-white dark:bg-slate-900/50 border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">+1.5M</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">Comprobantes procesados</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-black text-emerald-600 dark:text-emerald-400 font-mono">99.9%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">Disponibilidad en la nube</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400 font-mono">&lt; 2s</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">Tiempo promedio de timbrado</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">24/7</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-1">Monitoreo de infraestructura</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS CODEMARKET LAB -->
  <section class="py-24" id="servicios">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs uppercase font-extrabold tracking-widest text-blue-600 dark:text-blue-400">Capacidades de Ingeniería</h2>
        <p class="mt-2 text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">Soluciones tecnológicas orientadas al negocio</p>
        <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">Desarrollamos arquitectura informática diseñada para operar sin interrupciones, con alta seguridad y tolerancia a fallos.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Servicio 1 -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-8 rounded-3xl shadow-sm hover:border-blue-500 transition group flex flex-col justify-between">
          <div>
            <div class="h-12 w-12 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl mb-6">
              💻
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
              Desarrollo de Software a Medida
            </h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6 font-normal">
              Diseño y arquitectura de plataformas web, intranets operativas y sistemas SaaS adaptados estrictamente a la lógica operativa de tu negocio.
            </p>
            <ul class="space-y-2 text-xs text-slate-500 dark:text-slate-400">
              <li class="flex items-center gap-2">✓ Arquitecturas modulares, seguras y escalables.</li>
              <li class="flex items-center gap-2">✓ Paneles de administración e interfaces reactivas.</li>
              <li class="flex items-center gap-2">✓ Código limpio, documentado y preparado para crecer.</li>
            </ul>
          </div>
          <a 
            href="https://wa.me/51920306004?text=Hola%20CodeMarket,%20deseo%20cotizar%20un%20Software%20a%20Medida" 
            target="_blank" 
            class="mt-8 text-xs font-bold text-blue-600 dark:text-blue-400 inline-flex items-center gap-1 group-hover:gap-2 transition-all"
          >
            Cotizar requerimiento →
          </a>
        </div>

        <!-- Servicio 2 -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-8 rounded-3xl shadow-sm hover:border-emerald-500 transition group flex flex-col justify-between">
          <div>
            <div class="h-12 w-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl mb-6">
              ⚡
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition">
              APIs & Facturación Electrónica SUNAT
            </h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6 font-normal">
              Conectamos tus plataformas existentes (CRMs, tiendas WooCommerce, Shopify, Magento o sistemas legacy) con los servidores de SUNAT u OSE.
            </p>
            <ul class="space-y-2 text-xs text-slate-500 dark:text-slate-400">
              <li class="flex items-center gap-2">✓ Emisión automatizada de facturas, boletas y GRE.</li>
              <li class="flex items-center gap-2">✓ Generación de XML UBL 2.1, firma digital y CDR oficial.</li>
              <li class="flex items-center gap-2">✓ Integración por API RESTful sencilla y bien documentada.</li>
            </ul>
          </div>
          <a 
            href="https://wa.me/51920306004?text=Hola%20CodeMarket,%20deseo%20integrar%20mi%20sistema%20con%20SUNAT" 
            target="_blank" 
            class="mt-8 text-xs font-bold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1 group-hover:gap-2 transition-all"
          >
            Consultar integración API →
          </a>
        </div>

        <!-- Servicio 3 -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-8 rounded-3xl shadow-sm hover:border-sky-500 transition group flex flex-col justify-between">
          <div>
            <div class="h-12 w-12 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center text-2xl mb-6">
              ☁️
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition">
              Arquitectura Cloud & DevOps
            </h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6 font-normal">
              Aseguramos la estabilidad, velocidad y tolerancia a fallos de tus aplicaciones mediante despliegues modernos en servidores Linux y redes Cloudflare.
            </p>
            <ul class="space-y-2 text-xs text-slate-500 dark:text-slate-400">
              <li class="flex items-center gap-2">✓ Aprovisionamiento de VPS Linux (Ubuntu, Debian).</li>
              <li class="flex items-center gap-2">✓ Certificados SSL, cortafuegos WAF y mitigación de ataques.</li>
              <li class="flex items-center gap-2">✓ Automatización CI/CD con GitHub y Cloudflare Pages.</li>
            </ul>
          </div>
          <a 
            href="https://wa.me/51920306004?text=Hola%20CodeMarket,%20necesito%20soporte%20en%20Infraestructura%20Cloud" 
            target="_blank" 
            class="mt-8 text-xs font-bold text-sky-600 dark:text-sky-400 inline-flex items-center gap-1 group-hover:gap-2 transition-all"
          >
            Optimizar infraestructura →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- STACK TECNOLÓGICO (2 FILAS EQUILIBRADAS Y ESTÉTICAS) -->
  <section class="py-14 bg-white dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs uppercase font-extrabold tracking-widest text-slate-500 dark:text-slate-400 mb-8">
        Tecnologías que impulsan nuestras plataformas
      </p>

      <div class="space-y-3.5">
        
        <!-- Fila 1: Backend, Bases de Datos & Cloud (6 Tecnologías) -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          
          <!-- Node.js -->
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-emerald-500 transition group shadow-sm">
            <svg class="w-5 h-5 shrink-0 fill-[#5FA04E]" viewBox="0 0 24 24">
              <path d="M12 2L2 7.8v11.4l10 5.8 10-5.8V7.8L12 2zm-1.1 18.2L4 16.2V9.8l6.9 4v6.4zm2.2 0v-6.4l6.9-4v6.4l-6.9 4zM12 11.5L5.1 7.5 12 3.5l6.9 4-6.9 4z"/>
            </svg>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Node.js</span>
          </div>

          <!-- Python -->
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-blue-400 transition group shadow-sm">
            <svg class="w-5 h-5 shrink-0 fill-[#3776AB]" viewBox="0 0 24 24">
              <path d="M11.914 0C5.82 0 6.2 2.656 6.2 2.656l.006 2.75h5.813v.825H3.9S0 5.766 0 11.914c0 6.15 3.404 5.938 3.404 5.938h2.032v-2.86s-.11-3.404 3.348-3.404h5.757s3.238.052 3.238-3.18V2.656S18.27 0 11.914 0zm-3.238 1.832a1.03 1.03 0 110 2.062 1.03 1.03 0 010-2.062zM12.086 24c6.094 0 5.714-2.656 5.714-2.656l-.006-2.75h-5.813v-.825h8.12S24 18.234 24 12.086c0-6.15-3.404-5.938-3.404-5.938h-2.032v2.86s.11 3.404-3.348 3.404H9.459s-3.238-.052-3.238 3.18v5.75s-.488 2.656 5.865 2.656zm3.238-1.832a1.03 1.03 0 110-2.062 1.03 1.03 0 010 2.062z"/>
            </svg>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Python</span>
          </div>

          <!-- PostgreSQL -->
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-sky-500 transition group shadow-sm">
            <svg class="w-5 h-5 shrink-0 fill-[#4169E1]" viewBox="0 0 24 24">
              <path d="M12.001 0C5.372 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">PostgreSQL</span>
          </div>

          <!-- Redis -->
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-red-500 transition group shadow-sm">
            <svg class="w-5 h-5 shrink-0 fill-[#DC382D]" viewBox="0 0 24 24">
              <path d="M22.02 9.07l-9.5-5.5a1.03 1.03 0 00-1.04 0l-9.5 5.5a1.03 1.03 0 00-.52.9v11a1.03 1.03 0 00.52.9l9.5 5.5c.32.19.72.19 1.04 0l9.5-5.5a1.03 1.03 0 00.52-.9v-11a1.03 1.03 0 00-.52-.9zm-10.02-3.8l7.46 4.32-2.9 1.68-7.46-4.32 2.9-1.68zm-8 6.08l7 4.05v7.25l-7-4.05v-7.25zm9 11.3v-7.25l7-4.05v7.25l-7 4.05z"/>
            </svg>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Redis</span>
          </div>

          <!-- Docker -->
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 hover:border-blue-400 transition group shadow-sm">
            <svg class="w-5 h-5 shrink-0 fill-[#2496ED]" viewBox="0 0 24 24">
